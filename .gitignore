# Datasets are never committed - data/download.py fetches them.
data/raw/
data/interim/
data/processed/

# eval.predict output: raw model responses, token usage and metrics per run. Ignored by
# default - local experiment artifacts, not source. Specific runs are force-added and kept
# as evidence when they informed a documented decision (see README's baseline shakedown).
runs/*
!runs/deepseek-test/
!runs/gemini38-openrouter/
# Trained-adapter evidence (run_config, smoke, train_log): small, always kept.
!runs/train/
# Both sides of the ship-gate table. These are the project's results; they are committed.
!runs/vision-frontier/
!runs/vision-adapter/
# The same adapter under schema-constrained decoding, kept beside its unconstrained run.
!runs/vision-adapter-guided/

# Trained LoRA adapters downloaded from the GPU box: weights stay out of git. Their
# run_config.json / smoke.json / train_log.json are committed under runs/train/<name>/.
adapters/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

.env

# Copy to .env and fill in. `.env` is gitignored; source it before running eval/predict.py.

# The frontier baseline and the Path A pre-check go through the Anthropic API directly.
ANTHROPIC_API_KEY=

# --backend openai points at any OpenAI-compatible endpoint. Set --base-url on the CLI
# and put the matching key here - eval/predict.py reads OPENROUTER_API_KEY before
# OPENAI_API_KEY, so one balance covering several providers/models is the default case.
#   OpenRouter (openrouter.ai/api/v1): one balance, many models, no fixed top-up minimum.
OPENROUTER_API_KEY=
#   Any other OpenAI-compatible provider (DeepSeek's own platform, a vLLM server, etc).
#   A local vLLM server ignores auth entirely - leave this blank for that case.
OPENAI_API_KEY=
